generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

model School {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  timezone      String         @default("Asia/Kolkata")
  currency      String         @default("INR")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  academicYears AcademicYear[]
  users         User[]
  auditLogs     AuditLog[]
  terms         Term[]
  classes       SchoolClass[]
  sections      Section[]
  subjects      Subject[]
  teachers      Teacher[]
  classSubjects ClassSubject[]
  assignments   TeacherAssignment[]
}

model User {
  id          String      @id @default(cuid())
  schoolId    String
  authUserId  String
  email       String
  displayName String?
  status      UserStatus  @default(INVITED)
  lastLoginAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  roles       UserRole[]
  auditLogs   AuditLog[]  @relation("AuditActor")

  @@unique([schoolId, authUserId])
  @@unique([schoolId, email])
  @@index([authUserId])
  @@index([schoolId, status])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model AcademicYear {
  id        String             @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean            @default(false)
  status    AcademicYearStatus @default(PLANNED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  terms     Term[]
  classSubjects ClassSubject[]
  assignments TeacherAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Term {
  id             String          @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  sequence       Int
  status         RecordStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([academicYearId, name])
  @@unique([academicYearId, sequence])
  @@index([schoolId, academicYearId])
}

model SchoolClass {
  id           String              @id @default(cuid())
  schoolId     String
  name         String
  displayOrder Int
  status       RecordStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sections     Section[]
  classSubjects ClassSubject[]
  assignments  TeacherAssignment[]

  @@unique([schoolId, name])
  @@unique([schoolId, displayOrder])
  @@index([schoolId, status])
  @@map("classes")
}

model Section {
  id        String        @id @default(cuid())
  schoolId  String
  classId   String
  name      String
  room      String?
  capacity  Int?
  status    RecordStatus  @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class     SchoolClass   @relation(fields: [classId], references: [id], onDelete: Restrict)
  assignments TeacherAssignment[]

  @@unique([classId, name])
  @@index([schoolId, classId, status])
}

model Subject {
  id        String        @id @default(cuid())
  schoolId  String
  code      String
  name      String
  description String?
  status    RecordStatus  @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classSubjects ClassSubject[]
  assignments TeacherAssignment[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, status])
}

model ClassSubject {
  id             String        @id @default(cuid())
  schoolId       String
  academicYearId String
  classId        String
  subjectId      String
  isRequired     Boolean       @default(true)
  maximumMarks   Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  class          SchoolClass   @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([academicYearId, classId, subjectId])
  @@index([schoolId, academicYearId, classId])
}

model Teacher {
  id             String        @id @default(cuid())
  schoolId       String
  userId         String?       @unique
  employeeNumber String
  firstName      String
  middleName     String?
  lastName       String
  email          String?
  phone          String?
  department     String?
  designation    String?
  qualification  String?
  joinDate       DateTime?
  status         TeacherStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  assignments    TeacherAssignment[]

  @@unique([schoolId, employeeNumber])
  @@index([schoolId, status])
}

model TeacherAssignment {
  id             String           @id @default(cuid())
  schoolId       String
  teacherId      String
  academicYearId String
  classId        String
  sectionId      String
  subjectId      String
  isClassTeacher Boolean          @default(false)
  status         AssignmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  class          SchoolClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([teacherId, academicYearId, classId, sectionId, subjectId])
  @@index([schoolId, academicYearId, classId, sectionId, status])
}
